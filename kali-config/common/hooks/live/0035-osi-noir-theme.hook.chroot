#!/bin/bash
# ──────────────────────────────────────────────────────────────────────────────
# OSI Linux — finalize the OSI-Noir theme.
#
# The static parts of the theme (GTK 3/4 CSS, themerc, index.theme) are shipped
# as includes.chroot. This hook fills in the runtime-derived pieces:
#
#  - Copies xfwm4 pixmaps from the system Default theme into OSI-Noir so window
#    borders and title bars actually render. Then recolors them to grayscale
#    in case the source ships chromatic accents.
#  - Generates a tiny grayscale Adwaita-mono icon override (papirus-style mono
#    folder icons) if papirus-folders is available, otherwise no-ops.
#  - Caches GTK icon themes so first-login is snappy.
# ──────────────────────────────────────────────────────────────────────────────
set -euo pipefail
log() { printf '[OSI/theme] %s\n' "$*"; }

THEME=/usr/share/themes/OSI-Noir
XFWM_DST="$THEME/xfwm4"

# ── pull base xfwm4 pixmaps from the system Default theme ────────────────────
SRC=""
for cand in /usr/share/themes/Default/xfwm4 \
            /usr/share/themes/Daloa/xfwm4 \
            /usr/share/themes/Adwaita/xfwm4; do
    if [ -d "$cand" ]; then SRC="$cand"; break; fi
done

if [ -n "$SRC" ]; then
    log "seeding xfwm4 pixmaps from $SRC"
    # copy everything except themerc (we ship our own)
    find "$SRC" -maxdepth 1 -type f ! -name themerc -exec cp -n {} "$XFWM_DST"/ \;

    # Convert any remaining color in the pixmaps to grayscale.
    # Modern ImageMagick ships a policy.xml that blocks XPM (CVE-2016-3714 era
    # carry-over). We unblock it inside the chroot only for this build step.
    POLICY=/etc/ImageMagick-6/policy.xml
    POLICY_BAK=""
    if [ -f "$POLICY" ] && grep -q 'pattern="XPM"' "$POLICY" 2>/dev/null; then
        POLICY_BAK="$(mktemp)"
        cp "$POLICY" "$POLICY_BAK"
        sed -i 's#<policy domain="coder" rights="none" pattern="XPM"#<policy domain="coder" rights="read|write" pattern="XPM"#g' "$POLICY" || true
    fi

    if command -v convert >/dev/null 2>&1; then
        # Desaturating alone is not enough. The seed themes (Default, Daloa) are
        # LIGHT, so a grayscale copy is a LIGHT GREY theme: title bars rendered
        # at #c5c5c5 while themerc asked for #0a0a0a, and because xfwm4 prefers
        # pixmaps over themerc colours when both exist, the themerc was ignored.
        # With active_text_color=#ffffff that left white text on light grey —
        # near unreadable, and nothing like the intended black.
        #
        # Treat the two kinds of pixmap differently:
        #   frame pieces (title/top/bottom/left/right) -> flat noir fill, so the
        #       window chrome matches themerc exactly
        #   buttons -> grayscale then invert, turning the dark glyphs of a light
        #       theme into light glyphs that read against the dark bar
        log "recolouring xfwm4 pixmaps to the OSI-Noir palette"
        for f in "$XFWM_DST"/*.xpm "$XFWM_DST"/*.png; do
            [ -f "$f" ] || continue
            base="$(basename "$f")"
            case "$base" in
                title-*|top-*|bottom-*|left-*|right-*)
                    case "$base" in
                        *-inactive.*) fill="#000000" ;;
                        *)            fill="#0a0a0a" ;;
                    esac
                    convert "$f" -alpha off -fill "$fill" -colorize 100% "$f" 2>/dev/null || true
                    ;;
                *)
                    convert "$f" -colorspace Gray -channel RGB -negate "$f" 2>/dev/null || true
                    ;;
            esac
        done
    fi

    if [ -n "$POLICY_BAK" ]; then
        mv "$POLICY_BAK" "$POLICY"
    fi
else
    log "WARN: no source xfwm4 theme found; window borders will fall back to defaults"
fi

# ── icon theme: force Papirus folders to grey ────────────────────────────────
# Papirus ships pre-made colour variants (folder-grey-*.svg) and the upstream
# "papirus-folders" helper does nothing more than re-point the folder-*.svg
# symlinks at one colour. That helper is a third-party script and is NOT
# packaged in Kali, so the previous `command -v papirus-folders` guard always
# fell through — leaving folder.svg symlinked to folder-blue.svg and filling a
# strictly black-and-white desktop with bright blue folders in Thunar, the
# sidebar and every file dialog.
#
# Re-point the symlinks directly instead, so the result depends on nothing but
# the icon theme itself.
recolour_papirus_folders() {
    local theme_dir="$1" colour="$2"
    local dir variant base target
    [ -d "$theme_dir" ] || return 0
    for dir in "$theme_dir"/*/places; do
        [ -d "$dir" ] || continue
        for variant in "$dir/folder-${colour}"*.svg; do
            [ -e "$variant" ] || continue
            base="$(basename "$variant")"
            if [ "$base" = "folder-${colour}.svg" ]; then
                target="folder.svg"
            else
                target="folder-${base#folder-"${colour}"-}"
            fi
            ln -sf "$base" "$dir/$target"
        done
    done
}

for _theme in /usr/share/icons/Papirus-Dark /usr/share/icons/Papirus /usr/share/icons/Papirus-Light; do
    if [ -d "$_theme" ]; then
        log "recolouring $(basename "$_theme") folders → grey"
        recolour_papirus_folders "$_theme" grey
    fi
done

# ── force theme defaults system-wide (in addition to per-user xfconf xml) ────
mkdir -p /etc/gtk-3.0 /etc/gtk-4.0
cat > /etc/gtk-3.0/settings.ini << 'EOF'
[Settings]
gtk-theme-name=OSI-Noir
gtk-icon-theme-name=Papirus-Dark
gtk-cursor-theme-name=Adwaita
gtk-cursor-theme-size=24
gtk-font-name=Hack 10
gtk-application-prefer-dark-theme=true
gtk-decoration-layout=menu:minimize,maximize,close
gtk-enable-event-sounds=false
gtk-enable-input-feedback-sounds=false
gtk-xft-antialias=1
gtk-xft-hinting=1
gtk-xft-hintstyle=hintslight
gtk-xft-rgba=none
EOF
cp /etc/gtk-3.0/settings.ini /etc/gtk-4.0/settings.ini

# ── update icon caches (silent if cache tool absent) ─────────────────────────
if command -v gtk-update-icon-cache >/dev/null 2>&1; then
    for d in /usr/share/icons/Papirus-Dark /usr/share/icons/Adwaita; do
        [ -d "$d" ] && gtk-update-icon-cache -f -t "$d" >/dev/null 2>&1 || true
    done
fi

log "done"
