// ─────────────────────────────────────────────────────────────────────────────
// OSI Linux — Plymouth boot splash (cyber-noir, B&W).
//
// Font-free. Title, subtitle and progress-bar are pre-rendered PNGs shipped
// next to this script (generated by 0036-plymouth-assets at chroot build).
// Plymouth's initramfs hook copies the whole theme directory into the
// initramfs, so the PNGs travel with us — no fontconfig dependency.
//
// Layout (640x480 reference):
//   title.png        centered at y = 38%
//   subtitle.png     centered at y = 46%
//   bar-bg.png       centered at y = 60% (always full width)
//   bar-fg.png       overlaid, cropped horizontally to boot progress
// ─────────────────────────────────────────────────────────────────────────────

Window.SetBackgroundTopColor    (0.0, 0.0, 0.0);
Window.SetBackgroundBottomColor (0.0, 0.0, 0.0);

w = Window.GetWidth();
h = Window.GetHeight();

// ── Pre-rendered assets ─────────────────────────────────────────────────────
title_img    = Image("title.png");
subtitle_img = Image("subtitle.png");
bar_bg_img   = Image("bar-bg.png");
bar_fg_img   = Image("bar-fg.png");

// Title
title_sprite = Sprite(title_img);
title_sprite.SetX(w / 2 - title_img.GetWidth()    / 2);
title_sprite.SetY(h * 0.38);

// Subtitle
sub_sprite = Sprite(subtitle_img);
sub_sprite.SetX(w / 2 - subtitle_img.GetWidth() / 2);
sub_sprite.SetY(h * 0.46);

// Progress bar — bg always full, fg cropped to fraction of bg width
bar_w = bar_bg_img.GetWidth();
bar_h = bar_bg_img.GetHeight();
bar_x = w / 2 - bar_w / 2;
bar_y = h * 0.60;

bar_bg_sprite = Sprite(bar_bg_img);
bar_bg_sprite.SetX(bar_x);
bar_bg_sprite.SetY(bar_y);
bar_bg_sprite.SetZ(0);

bar_fg_sprite = Sprite();
bar_fg_sprite.SetX(bar_x);
bar_fg_sprite.SetY(bar_y);
bar_fg_sprite.SetZ(1);

progress = 0.0;

fun refresh_callback() {
    p = Plymouth.GetBootProgress();
    if (p > progress) progress = p;
    if (progress < 0.02) progress = 0.02;
    n = Math.Int(bar_w * progress);
    if (n < 1) n = 1;
    bar_fg_sprite.SetImage(bar_fg_img.Crop(0, 0, n, bar_h));
}
Plymouth.SetRefreshFunction(refresh_callback);

// ── Password/message prompts. Plymouth's default font is used (Image.Text
//    with a generic family name; Plymouth provides a built-in fallback when
//    fontconfig isn't available in the initramfs).
status_sprite = Sprite();
status_sprite.SetY(h * 0.70);

fun set_status(text) {
    img = Image.Text(text, 0.85, 0.85, 0.85, 1.0);
    status_sprite.SetImage(img);
    status_sprite.SetX(w / 2 - img.GetWidth() / 2);
}

fun display_message_callback(text)              { set_status(text); }
fun display_password_callback(prompt, bullets)  {
    pw = "";
    for (i = 0; i < bullets; i++) { pw = pw + "*"; }
    set_status(prompt + "  " + pw);
}
fun display_normal_callback() {
    status_sprite.SetImage(Image.Text("", 0, 0, 0, 0));
}

Plymouth.SetDisplayMessageFunction  (display_message_callback);
Plymouth.SetDisplayPasswordFunction (display_password_callback);
Plymouth.SetDisplayNormalFunction   (display_normal_callback);
